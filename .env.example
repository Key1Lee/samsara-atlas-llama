# LLM provider: stub (default), ollama, or local
PROVIDER_TYPE=ollama

# Variant (alpha|beta|gamma|delta|epsilon) - provided in your take-home packet
# CHALLENGE_VARIANT=alpha

# Authentication is required by default; configure API credentials for employee access.
ATLAS_ENV=production
# For an intentional local synthetic demo only, use ATLAS_ENV=development on API AND UI.
# API mapping: employee ID -> SHA-256 hash of its private bearer token (never the token itself).
# ATLAS_EMPLOYEE_TOKEN_HASHES={"E10234":"<64-character-sha256-hex-digest>"}

# Separate operator credential for aggregate analytics (required even in demo mode).
# ATLAS_ANALYTICS_TOKEN_HASH=<64-character-sha256-hex-digest>

# Separate local offline evaluator; disabled and disconnected from employee requests.
ATLAS_EVAL_ENABLED=0
ATLAS_EVAL_DIAGNOSTICS=0
ATLAS_EVAL_URL=http://127.0.0.1:11434
ATLAS_EVAL_MODEL=gpt-oss:20b
# Full local /api/tags digest required for semantic evaluation; moving tags fail closed.
# ATLAS_EVAL_DIGEST=<64-character-model-digest>
ATLAS_EVAL_TIMEOUT=120
ATLAS_EVAL_QUEUE=4
